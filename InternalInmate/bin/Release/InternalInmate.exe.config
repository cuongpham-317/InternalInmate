<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <connectionStrings>
        <!--
        ====================================================================================================
        CẤU HÌNH KẾT NỐI CƠ SỞ DỮ LIỆU SQL SERVER (DEFAULTCONNECTION)
        Khi public source code hoặc deploy trên máy chủ / máy trạm khác, bạn chỉ cần thay đổi 
        chuỗi kết nối "DefaultConnection" tại đây mà KHÔNG CẦN biên dịch lại mã nguồn.
        
        MỘT SỐ MẪU KẾT NỐI THÔNG DỤNG:
        1. SQL Server mặc định trên máy (Windows Authentication):
           Server=.;Database=ProfileManagementDb;Integrated Security=True;TrustServerCertificate=True;
           
        2. SQL Server Named Instance (ví dụ SQL Express):
           Server=.\SQLEXPRESS;Database=ProfileManagementDb;Integrated Security=True;TrustServerCertificate=True;
           
        3. SQL Server LocalDB:
           Server=(localdb)\MSSQLLocalDB;Database=ProfileManagementDb;Integrated Security=True;TrustServerCertificate=True;
           
        4. SQL Server xác thực tài khoản SQL (User/Password - nội bộ LAN hoặc từ xa):
           Server=127.0.0.1;Database=ProfileManagementDb;User ID=sa;Password=YourPassword;TrustServerCertificate=True;
           hoặc
           Server=192.168.1.100,1433;Database=ProfileManagementDb;User ID=sa;Password=YourPassword;TrustServerCertificate=True;
        ====================================================================================================
        -->
        <add name="DefaultConnection" 
             connectionString="Server=.;Database=ProfileManagementDb;Integrated Security=True;TrustServerCertificate=True;" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>

    <appSettings>
        <!-- Tên CSDL: Mặc định sẽ tự động lấy từ Database/Initial Catalog trong connectionString ở trên. 
             Nếu muốn chỉ định rõ tên database khác, bạn có thể bỏ comment dòng sau: -->
        <!-- <add key="DatabaseName" value="ProfileManagementDb" /> -->
    </appSettings>
</configuration>